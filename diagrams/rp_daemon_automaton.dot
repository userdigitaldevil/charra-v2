digraph rp_daemon {
  compound=true; newrank=true; rankdir=TB; bgcolor="white";
  splines=ortho; esep=0.3;
  fontname="Helvetica"; labelloc="t"; labeljust="l"; fontsize=20;
  ranksep=0.5; nodesep=0.7;

  label=<<b>CHARRA v2 — Relying Party, daemon mode</b><br align="left"/>
<font point-size="11">The RP's own states run down the <b>left</b> spine; each peer it talks to sits on its <b>right</b>, on the same line.<br align="left"/>
Read the vocabulary table first — several words below are narrower than they look.<br align="left"/></font>>;

  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="#f8fafc", color="#334155", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=10, color="#334155"];


  /* ---------------- vocabulary ------------------------------------------ */
  LEG [shape=plaintext, fillcolor="none", label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
  <TR><TD BGCOLOR="#1e293b" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="12"><B>NOTATION &amp; VOCABULARY</B></FONT></TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>AK_a</B> / <B>AK_r</B></TD>
      <TD ALIGN="LEFT">The <B>Attester's</B> / the <B>RP's</B> attestation key. Each is re-derived on demand from <B>its own TPM</B> and is<BR ALIGN="LEFT"/>trusted <B>iff</B> it appears in the trust anchor. Nothing is cached, stored, or certified.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>trust anchor</B></TD>
      <TD ALIGN="LEFT"><FONT FACE="Courier">keys/trusted_keys.txt</FONT> — a flat list of public keys. <B>Presence IS trust.</B> No EK, no CA, no<BR ALIGN="LEFT"/>certificates, no chain, no revocation, no expiry. Written offline, before any role starts.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><B>qualified</B></TD>
      <TD ALIGN="LEFT"><B>A narrow word.</B> The RP proved, on a Verifier's <B>synthetic</B> log, that its <B>SDK redaction<BR ALIGN="LEFT"/>pipeline</B> emits byte-identical output to the Verifier's own. It says <B>nothing</B> about the RP's<BR ALIGN="LEFT"/>machine, its integrity, or the real evidence it forwards. <B>The only thing here that expires</B> —<BR ALIGN="LEFT"/>because behaviour can change after passing, whereas an identity cannot stop being itself.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>log_a</B> / <B>log_r</B></TD>
      <TD ALIGN="LEFT">The Attester's <B>raw</B> IMA log / the RP's <B>redacted</B> version of it (paths rewritten, digests intact).</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>Quote_a</B> / <B>Quote_r</B></TD>
      <TD ALIGN="LEFT">TPM2_Quote taken by the <B>Attester</B> over PCRs {0..7, 10} with its RESTRICTED key /<BR ALIGN="LEFT"/>by the <B>RP</B> over PCR 23 with its unrestricted key. Both are built AND signed inside a TPM.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><B>verdict</B></TD>
      <TD ALIGN="LEFT">A Verifier's vote, <B>ECDSA-signed</B> with <FONT FACE="Courier">keys/verifier.der</FONT> and bound to the round: it carries<BR ALIGN="LEFT"/>the Verifier's own nonce, a SHA-256 of the evidence appraised, and a timestamp. The RP<BR ALIGN="LEFT"/>counts it only if <B>all four</B> check out — signature, nonce, digest, clock skew.<BR ALIGN="LEFT"/><B>Fail-closed</B> — an unverifiable YES is a NO. All Verifiers share one keypair today, so a<BR ALIGN="LEFT"/>signature says &quot;some Verifier&quot;; the <B>nonce</B> keeps votes in their own slots.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f0fdfa"><B>replay</B></TD>
      <TD ALIGN="LEFT">Re-applying a log's digests from zero to rebuild a PCR value. <B>Where it runs is the whole<BR ALIGN="LEFT"/>design:</B> in a <B>TPM</B> when you are <B>proving</B> a value, in <B>software</B> when you are <B>checking</B> one.<BR ALIGN="LEFT"/>So the RP replays log_a in software (step 3) but log_r in its TPM (step 5); the Verifier<BR ALIGN="LEFT"/>replays log_r in software. Identical arithmetic — only the proof differs.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>--flag</B></TD>
      <TD ALIGN="LEFT">A <B>local setting</B> of whichever process is named, never a protocol message. Defaults shown.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#fee2e2"><FONT COLOR="#b91c1c"><B>▸ abort</B></FONT></TD>
      <TD ALIGN="LEFT">A connector, not a wire: &quot;continue at <I>attestation cycle abandoned</I>&quot;. Four failure paths would otherwise<BR ALIGN="LEFT"/>become four page-crossing lines.</TD></TR>

  <TR><TD ALIGN="LEFT" BGCOLOR="#f8fafc"><B>colours</B></TD>
      <TD ALIGN="LEFT"><FONT COLOR="#5b21b6"><B>purple</B></FONT> Trust Manager &#183; <FONT COLOR="#0d9488"><B>teal</B></FONT> Attester &#183; <FONT COLOR="#c2410c"><B>orange</B></FONT> Verifier &#183; diamonds are guards</TD></TR>
</TABLE>>];


  /* ---------------- tunables -------------------------------------------- */
  TUNE [shape=plaintext, fillcolor="none", label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
  <TR><TD BGCOLOR="#1e293b" COLSPAN="4"><FONT COLOR="white" POINT-SIZE="12"><B>TUNABLE FROM run_daemon.sh</B> &#8212; <FONT POINT-SIZE="10">every one is an environment override, e.g. <FONT FACE="Courier">RP_VERIFIERS=3 VERIFIER_QUALIFICATION_VALIDITY=20 ./scripts/run_daemon.sh</FONT></FONT></FONT></TD></TR>
  <TR><TD BGCOLOR="#e2e8f0"><B>env var</B></TD><TD BGCOLOR="#e2e8f0"><B>becomes</B></TD><TD BGCOLOR="#e2e8f0"><B>default</B></TD><TD BGCOLOR="#e2e8f0"><B>what it changes</B></TD></TR>

  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_VERIFIERS</FONT></TD><TD ALIGN="LEFT"><B>--verifiers</B></TD><TD ALIGN="RIGHT"><B>5</B></TD>
      <TD ALIGN="LEFT">Verifiers per attestation cycle (1..10) — also how many get started. Sets the majority denominator.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_INTERVAL</FONT></TD><TD ALIGN="LEFT"><B>--interval</B></TD><TD ALIGN="RIGHT"><B>15s</B></TD>
      <TD ALIGN="LEFT">Sleep between attestation cycles (step 9).</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_CYCLES</FONT></TD><TD ALIGN="LEFT"><B>--cycles</B></TD><TD ALIGN="RIGHT"><B>0</B></TD>
      <TD ALIGN="LEFT">Stop after N attestation cycles. 0 = unbounded.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_DURATION</FONT></TD><TD ALIGN="LEFT"><B>--duration</B></TD><TD ALIGN="RIGHT"><B>0</B></TD>
      <TD ALIGN="LEFT">Stop after roughly N seconds. 0 = run until SIGINT.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_VERIFIER_TIMEOUT</FONT></TD><TD ALIGN="LEFT"><B>--verifier-timeout</B></TD><TD ALIGN="RIGHT"><B>6s</B></TD>
      <TD ALIGN="LEFT">Wait per round trip to a <B>Verifier</B> — /nonce, /qualify, /qualify_submit, /appraise. A timeout<BR ALIGN="LEFT"/>counts as a <B>NO</B> vote, exactly like a rejection. Does <B>not</B> cover step 1: the Trust Manager<BR ALIGN="LEFT"/>exchange has its own fixed 30s and no flag.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_ATTESTER_TIMEOUT</FONT></TD><TD ALIGN="LEFT"><B>--attester-timeout</B></TD><TD ALIGN="RIGHT"><B>6s</B></TD>
      <TD ALIGN="LEFT">Wait for the Attester's evidence (step 2). Exceeding it abandons the attestation cycle.</TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><FONT FACE="Courier">VERIFIER_QUALIFICATION_VALIDITY</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><B>--qualification-validity</B></TD><TD ALIGN="RIGHT" BGCOLOR="#fff7ed"><B>180s</B></TD>
      <TD ALIGN="LEFT" BGCOLOR="#fff7ed">How long a passing /qualify is honoured. <B>Verifier-side flag</B> — the RP learns the resulting<BR ALIGN="LEFT"/>deadline from the /qualify_submit response, so it needs no matching flag. Set it below<BR ALIGN="LEFT"/><B>120s</B> to watch the RP re-qualify mid-run; run_daemon.sh warns when you do.</TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#f0fdfa"><FONT FACE="Courier">TWO_TPMS</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f0fdfa">—</TD><TD ALIGN="RIGHT" BGCOLOR="#f0fdfa"><B>1</B></TD>
      <TD ALIGN="LEFT" BGCOLOR="#f0fdfa">One simulator per role (Phase 0). <B>0</B> falls back to a single shared TPM, where both AKs<BR ALIGN="LEFT"/>come from one seed.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">ATTESTER_TPM_PORT</FONT> / <FONT FACE="Courier">RP_TPM_PORT</FONT></TD><TD ALIGN="LEFT">—</TD><TD ALIGN="RIGHT"><B>2321 / 2325</B></TD>
      <TD ALIGN="LEFT">Each simulator binds PORT and PORT+1, so these must differ by at least 2.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">TPM_STATE_DIR</FONT></TD><TD ALIGN="LEFT">—</TD><TD ALIGN="RIGHT"><B>.tpm-state</B></TD>
      <TD ALIGN="LEFT">Where each simulator keeps its NVChip, one directory per TPM. Under the bind-mounted<BR ALIGN="LEFT"/>checkout, not the container: the container is <FONT FACE="Courier">--rm</FONT>, so state in its /tmp could not outlive<BR ALIGN="LEFT"/>a run — which is what made <FONT FACE="Courier">--keep-state</FONT> meaningless before.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RESET_TPM</FONT></TD><TD ALIGN="LEFT"><FONT FACE="Courier">--keep-state</FONT> = 0</TD><TD ALIGN="RIGHT"><B>1</B></TD>
      <TD ALIGN="LEFT">Wipe each NVChip and re-run TPM2_Startup. This changes every AK, which is why the<BR ALIGN="LEFT"/>trust anchor is regenerated straight afterwards.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">VERIFIER_START_PORT</FONT> / <FONT FACE="Courier">VERIFIER_HOST</FONT></TD><TD ALIGN="LEFT">—</TD><TD ALIGN="RIGHT"><B>5684 / 127.0.0.1</B></TD>
      <TD ALIGN="LEFT">First Verifier port, rest follow; address written into verifiers_config.txt.</TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><FONT FACE="Courier">DTLS_MODE</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7ed"><B>--psk</B> / <B>--rpk</B></TD><TD ALIGN="RIGHT" BGCOLOR="#fff7ed"><B>off</B></TD>
      <TD ALIGN="LEFT" BGCOLOR="#fff7ed"><FONT FACE="Courier">off</FONT> | <FONT FACE="Courier">psk</FONT> | <FONT FACE="Courier">rpk</FONT>. One variable for <B>all four roles</B>, because they must agree and a<BR ALIGN="LEFT"/>mismatch does not error: the request times out, and a timeout is a <B>NO</B> vote — so it reads as<BR ALIGN="LEFT"/>a failed attestation. <FONT FACE="Courier">rpk</FONT> is mutual, using the keypairs in <FONT FACE="Courier">keys/</FONT>. Hop-by-hop, so it does<BR ALIGN="LEFT"/><B>not</B> replace the signed verdict, which is end-to-end.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">LOG_LEVEL</FONT> / <FONT FACE="Courier">LOG_LEVEL_COAP</FONT></TD><TD ALIGN="LEFT"><B>--log-level</B></TD><TD ALIGN="RIGHT"><B>INFO</B> / unset</TD>
      <TD ALIGN="LEFT">TRACE DEBUG INFO WARN ERROR FATAL. CoAP unset leaves libcoap at its own default.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RECOMPILE</FONT></TD><TD ALIGN="LEFT">—</TD><TD ALIGN="RIGHT"><B>1</B></TD>
      <TD ALIGN="LEFT">make clean &amp;&amp; make -j inside the container before starting anything.</TD></TR>
  <TR><TD ALIGN="LEFT"><FONT FACE="Courier">RP_EXTRA_ARGS</FONT> / <FONT FACE="Courier">VERIFIER_</FONT> / <FONT FACE="Courier">ATTESTER_</FONT></TD><TD ALIGN="LEFT">pass-through</TD><TD ALIGN="RIGHT">empty</TD>
      <TD ALIGN="LEFT">Free-form flags for any option this table does not name.</TD></TR>
</TABLE>>];

  /* ---------------- Phase 0: offline, before any role starts ------------ */
  subgraph cluster_setup {
    label=<<b>Phase 0 — offline setup (run_daemon.sh, before any role starts)</b>>;
    fontsize=13; style="rounded,dashed"; color="#64748b"; margin=12;

    P0 [label=<<b>two TPM simulators started</b><br align="left"/>
<font point-size="10">attester TPM :2321 · RP TPM :2325 — separate NVChip dirs,<br align="left"/>
each given its own TPM2_Startup(CLEAR). Separate seeds, so the<br align="left"/>
two AKs are unrelated by construction.</font><br align="left"/>>,
        fillcolor="#f1f5f9"];

    P1 [label=<<b>provision_trusted_keys --role</b> · twice<br align="left"/>
<font point-size="10">--role attester      against the attester TPM → AK_a public half<br align="left"/>
--role relying-party against the RP TPM       → AK_r public half<br align="left"/>
Concatenated into <font face="Courier">keys/trusted_keys.txt</font>.<br align="left"/>
<b>--role is a security boundary</b>: without it each run emits BOTH<br align="left"/>
identities, putting a key the RP's own TPM can derive into the<br align="left"/>
anchor labelled 'attester'.</font><br align="left"/>>,
        fillcolor="#f1f5f9"];

    P0 -> P1;
  }

  /* ---------------- one attestation cycle ------------------------------ */
  S0 [label=<<b>start of one attestation cycle</b><br align="left"/>
<font point-size="10">Loops until one of the three stop conditions in SHUTDOWN below fires.<br align="left"/>
Defaults: <b>--cycles</b> 0 (unbounded), <b>--duration</b> 0 (no deadline).</font><br align="left"/>>,
      fillcolor="#e0e7ff"];

  S1 [label=<<b>1 · get verifiers</b><br align="left"/>
<font point-size="10">asks the Trust Manager for <b>--verifiers</b> (5) addresses</font><br align="left"/>>];

  S2 [label=<<b>2 · get evidence from the Attester</b><br align="left"/>
<font point-size="10">RP picks a nonce and a PCR selection <b>{0..7, 10}</b>, calls /attest</font><br align="left"/>>];

  S3 [label=<<b>3 · Step 2a — RP appraises Quote_a locally</b>&nbsp;&nbsp;<font point-size="9">[RP as CHECKER]</font><br align="left"/>
<font point-size="10">① AK_a in the trust anchor  ② Quote_a signature  ③ nonce<br align="left"/>
④ log entries self-consistent  ⑥ file hashes vs whitelist/blacklist<br align="left"/>
⑤ replay <b>log_a</b> — the ATTESTER's raw log — <b>in SOFTWARE</b>, and<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;compare against Quote_a's PCR digest. Software because the RP is<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;checking someone else's claim, not making one. <b>Not</b> the step-5<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;replay: different log, different purpose, different machine.<br align="left"/>
All six run even after one fails, so one pass reports everything.</font><br align="left"/>>];

  S4 [label=<<b>4 · privacy-clean → log_r</b><br align="left"/>
<font point-size="10">charra_sdk_redact_ima_log() rewrites each entry's PATH only.<br align="left"/>
Randomised, so it is done ONCE per attestation cycle — per Verifier would<br align="left"/>
hand each of them a different log_r for the same attestation.</font><br align="left"/>>];

  S5 [label=<<b>5 · replay log_r into PCR 23, on the RP's TPM</b>&nbsp;&nbsp;<font point-size="9">[RP as PROVER]</font><br align="left"/>
<font point-size="10">TPM2_PCR_Reset(23), then one TPM2_PCR_Extend per entry.<br align="left"/>
<b>Once per attestation cycle, not per Verifier</b> — quoting reads a PCR without<br align="left"/>
consuming it, so one replay backs every quote below.<br align="left"/>
PCR 23 because it is resettable from locality 0 and PCR 10 is not,<br align="left"/>
and because it is outside the Attester's quoted selection.</font><br align="left"/>>];

  Q [label=<<b>is the RP still qualified at this point?</b><br align="left"/>
<font point-size="9">Checked against the wall clock, <b>with no safety margin</b>: the grant<br align="left"/>
need only be valid HERE, not for the whole round that follows. One<br align="left"/>
that lapses mid-round costs that attestation cycle — every Verifier votes NO and<br align="left"/>
/appraise never says why. The next attestation cycle re-qualifies and it corrects.<br align="left"/>
no → qualify first (step 6) · yes → straight to step 7</font>>, shape=diamond,
     fillcolor="#fef3c7", color="#b45309", margin=0.04];

  S6 [label=<<b>6 · qualify (ONE Verifier — the first reachable)</b><br align="left"/>
<font point-size="10">Redact the Verifier's synthetic challenge log with the SDK and<br align="left"/>
sign (log ‖ salt) with AK_r. <b>No PCR, no replay</b> — the Verifier<br align="left"/>
compares log bytes, and identical logs replay identically.<br align="left"/>
The signature says WHO submitted; the salt binds it to THIS challenge.</font><br align="left"/>>];

  S7 [label=<<b>7 · per Verifier, in parallel threads</b><br align="left"/>
<font point-size="10">GET /nonce  →  TPM2_Quote(PCR 23, qualifyingData = that nonce)<br align="left"/>
→ POST /appraise. One quote each, over the one shared replay.<br align="left"/>
The answer is a <b>signed verdict</b>, checked before it is counted:<br align="left"/>
signature under the Verifier's key, its own nonce, and a digest of<br align="left"/>
the evidence THIS thread sent. Any of those wrong → no vote.</font><br align="left"/>>];

  S8 [label=<<b>8 · majority vote</b><br align="left"/>
<font point-size="10">fail-closed: a Verifier counts as a pass only if it appraised AND<br align="left"/>
accepted AND that verdict verified. Unreachable, timed out, never<br align="left"/>
sent, or unverifiable all count as NO. The tally ends here — it is<br align="left"/>
logged, and never sent onward to the Attester.</font><br align="left"/>>,
      fillcolor="#e0e7ff"];

  subgraph cluster_loopctl {
    label=<<b>9 · Loop control</b> — every attestation cycle, finished or abandoned, arrives here.<br align="left"/><font point-size="10">The three ways this daemon stops, in the order they are tested. Fall through all three and it sleeps.</font><br align="left"/>>;
    fontsize=13; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; margin=10;

    QQUIT [label=<<b>asked to stop?</b><br align="left"/><font point-size="9">SIGINT (Ctrl-C) or SIGTERM<br align="left"/>(docker stop, timeout, systemd) —<br align="left"/>from the OS, never from a peer</font>>,
           shape=diamond, fillcolor="#fef3c7", color="#b45309", width=2.2, height=1.15];
    QCYC  [label=<<b>--cycles reached?</b><br align="left"/><font point-size="9">default 0 = unbounded</font>>,
           shape=diamond, fillcolor="#fef3c7", color="#b45309", width=2.0, height=0.95];
    QDUR  [label=<<b>--duration elapsed?</b><br align="left"/><font point-size="9">default 0 = no deadline</font>>,
           shape=diamond, fillcolor="#fef3c7", color="#b45309", width=2.0, height=0.95];
  }

  NAP [label=<<b>nap min(--interval, time left on --duration)</b><br align="left"/>
<font point-size="9">Clamped so a --duration deadline is honoured to within a second, not overshot<br align="left"/>
by a whole interval. Sliced into 1s steps so the stop flag is re-tested — though<br align="left"/>
<font face="Courier">sleep()</font> is <font face="Courier">nanosleep</font>, which a signal never restarts, so a Ctrl-C 2s into a 60s<br align="left"/>
nap exits in <b>~0.1s</b> (measured). The slicing is portability insurance, not the reason.<br align="left"/>
<b>Leaves early for two reasons</b>: a signal, or --duration running out (re-tested<br align="left"/>
after the nap as well as before it). Either way → SHUTDOWN.</font><br align="left"/>>,
       fillcolor="#e0e7ff"];

  STOP [label=<<b>SHUTDOWN</b><br align="left"/>
<font point-size="10">One line reports which of the three fired. An attestation cycle already in flight is not torn<br align="left"/>
down mid-way. The quit flag is tested at every phase boundary <b>and inside the two<br align="left"/>
longest loops</b> — the CoAP wait and the PCR extend — so a stop lands within one I/O<br align="left"/>
slice, not one whole round trip: measured <b>~1.0s</b> signalled mid-fan-out, <b>~0.1s</b><br align="left"/>
during the nap.<br align="left"/>
Both loops return an ERROR when quit is what ended them, never success: a wait that<br align="left"/>
exits early saw no response, and a partial replay leaves PCR 23 holding a value no<br align="left"/>
log explains — which must never be quoted.</font><br align="left"/>>,
        fillcolor="#dcfce7", color="#15803d", penwidth=1.8];

  ABORT [label=<<b>attestation cycle abandoned</b>&nbsp;&nbsp;<font point-size="10">◂ every ▸ abort lands here</font><br align="left"/>
<font point-size="10">Not fatal: falls into loop control like a completed attestation cycle, and the next one<br align="left"/>
starts fresh. The RP does not retry within an attestation cycle — a briefly unreachable<br align="left"/>
peer costs one attestation cycle.</font><br align="left"/>>,
         fillcolor="#fee2e2", color="#b91c1c"];

  /* ---------------- peers ---------------------------------------------- */
  TM [label=<<b>TRUST MANAGER</b> · /get_verifiers<br align="left"/>
<font point-size="10">resolves IDs to host:port from verifiers_config.txt.<br align="left"/>
Opens no TPM.</font><br align="left"/>>,
      fillcolor="#f5f3ff", color="#5b21b6"];

  ATT [label=<<b>ATTESTER</b> · /attest, /attest_result<br align="left"/>
<font point-size="10">Extends its real IMA log into PCR 10, then TPM2_Quote over<br align="left"/>
{0..7, 10} with <b>AK_a</b> — its TPM's RESTRICTED primary, the only<br align="left"/>
kind whose signature proves the TPM built the structure.<br align="left"/>
Returns Quote_a + log_a + AK_a's public half.<br align="left"/>
/attest_result receives the RP's Step 2a verdict.</font><br align="left"/>>,
       fillcolor="#f0fdfa", color="#0d9488"];

  VQ [label=<<b>VERIFIER</b> · /qualify, /qualify_submit<br align="left"/>
<font point-size="10">Fabricates a synthetic log, redacts it itself for the golden answer,<br align="left"/>
sends the raw log + salt. On submit: AK_r in the anchor, signature<br align="left"/>
over (log ‖ salt) valid, and the RP's redaction equal to the golden<br align="left"/>
one BYTE FOR BYTE. Records SHA-256(AK_r) + deadline in<br align="left"/>
<font face="Courier">qualified_rps.txt</font>, shared by every Verifier, and returns that<br align="left"/>
deadline. Window = <b>--qualification-validity</b> (180s), Verifier-only.</font><br align="left"/>>,
       fillcolor="#fff7ed", color="#c2410c"];

  VA [label=<<b>VERIFIER i</b> · /nonce, /appraise<br align="left"/>
<font point-size="10"><b>Step 3a</b> ① AK_r in the trust anchor<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;①b this RP qualified, per the shared file<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;② Quote_r signature under AK_r<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;③ nonce, read from the quote's <b>extraData</b><br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;④ replay <b>log_r</b> <b>in SOFTWARE</b> == the quote's pcrDigest<br align="left"/>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<font point-size="9">[Verifier as CHECKER — it opens no TPM at all]</font><br align="left"/>
<b>Step 3b</b> ① AK_a in the anchor  ② Quote_a signature  ③ nonce<br align="left"/>
Opens NO TPM: every check is public-key math or hashing.<br align="left"/>
③ and ④ together are what bind the log to a TPM-attested value.<br align="left"/>
<font color="#b91c1c">The verdict on the wire is a <b>signed</b> pass/fail and nothing more —<br align="left"/>
the RP is never told WHICH check failed. Reasons go to this<br align="left"/>
Verifier's log only. Both exits sign, so a NO that never reached<br align="left"/>
appraisal looks identical on the wire to one that did.</font></font><br align="left"/>>,
       fillcolor="#fff7ed", color="#c2410c"];

  /* ---------------- wiring --------------------------------------------- */
  LEG -> TUNE [style=invis];
  TUNE -> P0 [style=invis];
  P1 -> S0 [style=dashed, color="#64748b", xlabel=" anchor ready "];

  S0 -> S1 -> S2 -> S3 [weight=20];
  S3 -> S4 [xlabel=" Step 2a passed ", weight=20];
  S4 -> S5 -> Q [weight=20];
  Q  -> S6 [xlabel=" no "];
  Q  -> S7 [weight=10];
  S6 -> S7 [xlabel=" qualified ", weight=20];
  S7 -> S8 [weight=20];
  /* A completed attestation cycle AND an abandoned one both fall into loop control. */
  S8 -> QQUIT [weight=20];
  ABORT -> QQUIT [color="#b91c1c", style=dashed, constraint=false];
  QQUIT -> QCYC [xlabel=" no "];
  QCYC  -> QDUR [xlabel=" no "];
  QDUR  -> NAP  [xlabel=" no "];
  QQUIT -> STOP [color="#15803d", fontcolor="#15803d", xlabel=" yes "];
  QCYC  -> STOP [color="#15803d", fontcolor="#15803d", xlabel=" yes "];
  QDUR  -> STOP [color="#15803d", fontcolor="#15803d", xlabel=" yes "];
  /* --duration is re-tested after the nap too, and the nap itself is cut
   * short by a signal -- both land on the same terminal. */
  NAP -> STOP [color="#15803d", fontcolor="#15803d", constraint=false,
               xlabel=" yes "];
  NAP -> S0 [constraint=false, xlabel=" next attestation cycle "];

  S1 -> TM  [style=dashed, dir=both, color="#5b21b6"];
  S2 -> ATT [style=dashed, dir=both, color="#0d9488"];
  S3 -> ATT [style=dashed, color="#0d9488", xlabel=" verdict "];
  S6 -> VQ  [style=dashed, dir=both, color="#c2410c"];
  S7 -> VA  [style=dashed, dir=both, color="#c2410c"];

  /* Failure exits are drawn as CONNECTORS, not wires: four page-crossing
   * red lines cost more legibility than they buy. Each tag means
   * "continue at attestation cycle abandoned". */
  node [shape=triangle, style=filled, fillcolor="#fee2e2", color="#b91c1c",
        fontcolor="#b91c1c", fontsize=9, penwidth=1.4,
        fixedsize=true, width=0.95, height=0.62, margin=0];
  A1 [label="abort", xlabel=<<font point-size="9" color="#b91c1c">no verifiers</font>>];
  A2 [label="abort", xlabel=<<font point-size="9" color="#b91c1c">Step 2a failed</font>>];
  A3 [label="abort", xlabel=<<font point-size="9" color="#b91c1c">TPM replay failed</font>>];
  A4 [label="abort", xlabel=<<font point-size="9" color="#b91c1c">no Verifier reachable</font>>];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#334155",
        fontcolor="black", fontsize=11, penwidth=1.2, fixedsize=false,
        width=0.75, height=0.5, margin=0.11];

  /* Drawn A -> S so graphviz ranks the tag to the LEFT of the spine, where
   * the page is empty -- on the right it had to reach past the peer boxes,
   * which is what made the connectors long. */
  edge [color="#b91c1c", arrowhead=none, style=dotted, constraint=false];
  A1 -> S1; A2 -> S3; A3 -> S5; A4 -> S6;
  edge [color="#334155", arrowhead=normal, style=solid, constraint=true];

  /* failure exits */

  /* Peers pinned to the right of the state that calls them, and the RP's
   * own states weighted into a straight spine so the eye can follow it. */
  { rank=same; S2; ATT }
  { rank=same; S7; VA }
  { rank=same; S8; ABORT }
  /* NAP left, SHUTDOWN right, on their own row -- otherwise the two wide
   * boxes were laid out overlapping. */
  { rank=same; NAP -> STOP [style=invis]; }
  /* Invisible chains fix the LEFT-TO-RIGHT order inside each rank, which
   * rank=same alone does not: without them the tags drifted past the peer
   * boxes on the right and the connectors had to reach across the page. */
  { rank=same; A1 -> S1 -> TM [style=invis]; }
  { rank=same; A2 -> S3 [style=invis]; }
  { rank=same; A3 -> S5 [style=invis]; }
  { rank=same; A4 -> S6 -> VQ [style=invis]; }

  edge [style=invis];
  S0 -> S1 -> S2 -> S3 -> S4 -> S5 -> Q -> S6 -> S7 -> S8 [weight=100];
}
