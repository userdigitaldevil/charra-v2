# build artifacts
bin/*
obj/*

# core dumps
#core

# keep core folder
!src/core/*

# keep folders
!.gitkeep

# RP TPM identity cache (regenerated at runtime, same convention as
# bin/obj -- includes private key material, never commit). rp-ak-public/
# private.bin hold the one TPM-resident keypair; rp-ak-certificate-*.der is
# per-Verifier (one file per port -- each Verifier independently certifies
# RP's AK now, see ensure_rp_ak_certificate() in relying_party.c).
rp-ek-certificate.der
rp-ak-public.bin
rp-ak-private.bin
rp-ak-certificate-*.der

# per-Verifier runtime state ledgers (regenerated at runtime and mkdir'd by
# verifier.c's main() -- one file per Verifier port in each subfolder.
# state/rp-ak-provisioning/ holds AK-certificate issuance records (see
# ak_state_file_path in verifier.c: each Verifier independently tracks the
# certificates it has issued). state/rp-qualification/ holds RP-
# qualification records (see qualification_state_file_path in verifier.c).
# Named "rp-..." since these track the RP's identity specifically, not the
# Attester's -- which may get its own analogous ledger one day.
state/

# per-component runtime logs (overwritten on every run)
logs/*.log

# TPM simulator's persistent NVRAM state (regenerated by tpm-reset/tpm_server)
NVChip

# benchmark/timing output (overwritten on every run)
timings_attester.txt
timings_verifier.txt
timings_RP_multi_verifiers.txt
durations_verifier.txt

# VSCode
.vscode/

# Visual Studio
.vs/

