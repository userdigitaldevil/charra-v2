# build artifacts
bin/*
obj/*

# core dumps
#core

# keep core folder
!src/core/*

# keep folders
!.gitkeep

# Runtime-generated, never committed:
#   qualified_rps.txt  -- which RPs have passed /qualify, ONE file shared by
#     every Verifier instance so a single handshake counts with all of them
#     (see src/verifier/verifier_qualified_rps.h). Cleared by run_daemon.sh
#     on a TPM reset, since that changes the RP's key and orphans every line.
#   keys/trusted_keys.txt -- the trust anchor: the public signing keys every
#     role accepts, written from the TPM by keys/gen-trusted-keys.sh.
#     Regenerate after any TPM reset rather than committing it; the keys it
#     names belong to one specific NVChip.
#   verifiers_config.txt -- host:port per Verifier ID, rewritten by
#     start_verifiers.sh for however many Verifiers that run starts. It was
#     tracked, so every run with a different --verifiers showed up as a
#     spurious diff.
qualified_rps.txt
qualified_rps.txt.tmp
verifiers_config.txt
# each TPM simulator's NVChip, kept under the checkout so it survives the
# --rm container and RESET_TPM=0 can preserve the AKs across runs
.tpm-state/
keys/trusted_keys.txt
keys/trusted_keys.txt.tmp

# per-component runtime logs (overwritten on every run) -- whole tree,
# since ad-hoc runs also drop per-run subdirectories in here
logs/

# TPM simulator's persistent NVRAM state (regenerated by tpm-reset/tpm_server)
NVChip

# The IBM simulator source used to be vendored here. It was never referenced
# by the Dockerfile -- tpm_server comes from the base image
# (ghcr.io/tpm2-software/ubuntu-20.04) -- so it was 5 MB of dead weight.
# Ignored in case an old tarball is unpacked here again by habit.
ibmtpm1661/
ibmtpm1661.tar.gz

# benchmark/timing output (overwritten on every run)
timings_attester.txt
timings_verifier.txt
timings_RP_multi_verifiers.txt
durations_verifier*.txt

# VSCode
.vscode/

# Visual Studio
.vs/

.DS_Store

# --- ZK redaction proof -----------------------------------------------------
# Compiled circuit and its witness: rebuilt by `nargo compile` / `nargo
# execute`, and large. zk/vk IS committed, because the Verifier needs the key
# for the exact circuit the RP proves against.
zk/circuit/target/
# Generated from a witness by zk/gen_prover_toml.py, and it contains the
# secret paths and salts.
zk/circuit/Prover.toml
# The RP<->prover job queue: transient, and jobs carry the witness.
zk/jobs/
__pycache__/

# Vendored upstream clone kept for comparison only (openEuler Global Trust
# Authority, ~1.2 GB with its own .git). Re-clone rather than commit it:
#   git clone https://gitcode.com/openeuler/global-trust-authority.git
charra-ressources/evidence/global-trust-authority/
# Scratch output from driving that clone against a TPM simulator.
gta-run-output/
# log_r as the Verifiers receive it, rewritten by the RP every cycle
# (--redacted-log-out). Generated, like the timings_/durations_ files.
redacted_ima_logs.txt
