# build artifacts
bin/*
obj/*

# core dumps
#core

# keep core folder
!src/core/*

# keep folders
!.gitkeep

# Runtime-generated, never committed:
#   qualified_rps.txt  -- which RPs have passed /qualify, ONE file shared by
#     every Verifier instance so a single handshake counts with all of them
#     (see src/verifier/verifier_qualified_rps.h). Cleared by run_daemon.sh
#     on a TPM reset, since that changes the RP's key and orphans every line.
#   keys/trusted_keys.txt -- the trust anchor: the public signing keys every
#     role accepts, written from the TPM by keys/gen-trusted-keys.sh.
#     Regenerate after any TPM reset rather than committing it; the keys it
#     names belong to one specific NVChip.
qualified_rps.txt
qualified_rps.txt.tmp
keys/trusted_keys.txt
keys/trusted_keys.txt.tmp

# per-component runtime logs (overwritten on every run) -- whole tree,
# since ad-hoc runs also drop per-run subdirectories in here
logs/

# TPM simulator's persistent NVRAM state (regenerated by tpm-reset/tpm_server)
NVChip

# benchmark/timing output (overwritten on every run)
timings_attester.txt
timings_verifier.txt
timings_RP_multi_verifiers.txt
durations_verifier-*.txt

# VSCode
.vscode/

# Visual Studio
.vs/

.DS_Store
