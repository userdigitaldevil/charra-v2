# build artifacts
bin/*
obj/*

# core dumps
#core

# keep core folder
!src/core/*

# keep folders
!.gitkeep

# RP TPM identity cache (regenerated at runtime, same convention as
# bin/obj -- includes private key material, never commit). rp-ak-public/
# private.bin hold the one TPM-resident keypair; rp-ak-certificate-*.der is
# per-Verifier (one file per port -- each Verifier independently certifies
# RP's AK now, see ensure_rp_ak_certificate() in relying_party.c).
rp-ek-certificate.der
rp-ak-public.bin
rp-ak-private.bin
rp-ak-certificate-*.der

# per-Verifier AK-provisioning ledger (regenerated at runtime, one file per
# port -- see ak_state_file_path in verifier.c; each Verifier independently
# tracks the certificates it has issued, same reasoning as the RP-
# qualification ledger below)
ak-provisioning-state-*.txt
ak-provisioning-state-*.txt.lock

# per-Verifier RP-qualification ledger (regenerated at runtime, one file
# per port -- see qualification_state_file_path in verifier.c)
qualification-state-*.txt
qualification-state-*.txt.lock

# per-component runtime logs (overwritten on every run)
logs/*.log

# TPM simulator's persistent NVRAM state (regenerated by tpm-reset/tpm_server)
NVChip

# benchmark/timing output (overwritten on every run)
timings_attester.txt
timings_verifier.txt
timings_RP_multi_verifiers.txt
durations_verifier.txt

# VSCode
.vscode/

# Visual Studio
.vs/

